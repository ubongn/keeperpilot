# ── KeeperHub connection (get a kh_ org key at app.keeperhub.com → Settings → API Keys) ──
KH_BASE_URL=https://app.keeperhub.com
KH_API_KEY=kh_replace_me
# Set to "true" to force simulate:true (dry-run, never broadcasts). Safe default for hacking.
KH_DRY_RUN=true

# ── Runtime ──
LOG_LEVEL=info
# Which network the agent trades on (sepolia | base-sepolia | base | ethereum | ...)
KH_NETWORK=sepolia
# The KeeperHub-managed wallet address the agent trades FROM (visible in dashboard)
KH_WALLET_ADDRESS=0x0000000000000000000000000000000000000000

# ── Agent strategy ──
# Rebalance target allocation, e.g. ETH 50 / USDC 50. Drift tolerance in percent.
AGENT_TARGET_ETH=50
AGENT_TARGET_USDC=50
AGENT_DRIFT_THRESHOLD_PCT=5
# Loop cadence (ms). 0 = run once and exit.
AGENT_LOOP_MS=0

# ── x402 gateway ──
X402_PORT=8787
# Where the gateway settles payments (base-usdc | tempo-usdce)
X402_SETTLE=base-usdc
# The wallet address that RECEIVES x402 payments
X402_RECEIVER=0x0000000000000000000000000000000000000000

# ── Dashboard ──
DASH_PORT=3000

# ── Optional: an LLM provider for natural-language strategy authoring via MCP ──
# LLM_API_KEY=
